# 依赖缓存与构建产物（体积大、可重建）
.cargo-home/
**/target/

# 运行期目录（会话日志、临时输出）
.rig-home/
.tmp/

# jj 的 XDG 重定向目录
.jjenv/

# 截图裁剪中间产物
render/rf_shots/crop_*.png

# 生成的 CJK 字体（用 tools/fetch_cjk_font.sh 重新生成）
rig_niri/assets/fonts/*.otf

# Python 依赖（fonttools，用于字体子集化）
tools/pylib/

# 上游源码，只读参考：niri 是 GPL-3.0，不进仓库
reference/niri/

# 一次性探针的抓取产物（能跑但不保证）
experiments/rig-tui-inspect/

# 巡游默认输出目录（RF_SHOT_DIR 未指定时）
shots/
.claude/
*.raw

# 官方 rig 的 crate 源码副本（可一键重新生成，见 reference/rig-official/README.md）
reference/rig-official/*
!reference/rig-official/README.md
!reference/rig-official/capture.py

# 一次性调试截图（不当作证据存档）
render/ws*/
render/layout_check/
render/dbg*/
render/final_check/

# 解包的上游 crate 源码（可重新解包，不进仓库）
reference/rig-tui-inspect/

# 浅色主题的验证截图（不进仓库，和 shots/ 一样只在本机看）
render/light/
